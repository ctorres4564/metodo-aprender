{
  "name": "metodo-aprender",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --project demo-metodo-aprender --only firestore,storage,auth \"vitest run --config vitest.emulator.config.js\"",
    "test:e2e": "firebase emulators:exec --project demo-metodo-aprender --only firestore,storage,auth \"playwright test\"",
    "benchmark:constructed-eval": "node test/benchmark/runConstructedEvaluationBenchmark.js",
    "report:ai-agreement": "node scripts/reportAiAgreement.js"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "firebase-admin": "14.2.0",
    "stripe": "^17.0.0"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "firebase": "^12.17.1",
    "firebase-tools": "^15.26.0",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.10"
  }
}
